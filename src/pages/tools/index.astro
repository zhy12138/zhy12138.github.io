---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="工具 | zhy12138" description="只在当前浏览器中处理数据的小工具。">
  <section class="page-head">
    <p>Local Tools</p>
    <h1>工具</h1>
    <div>这里会陆续收录一些轻量小工具，用来处理只属于你的本地数据。</div>
  </section>

  <section class="tools-section" aria-labelledby="tools-title">
    <div class="section-head">
      <div>
        <p>Available</p>
        <h2 id="tools-title">工具列表</h2>
      </div>
    </div>
    <a class="tool-card" href="/tools/course-bidding/">
      <span class="tool-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 19V9" />
          <path d="M12 19V5" />
          <path d="M19 19v-7" />
          <path d="M3 19h18" />
        </svg>
      </span>
      <span class="tool-card__body">
        <span class="tool-card__meta">仅在本地</span>
        <strong>选课投点计算器</strong>
        <span>根据课程热度和个人偏好，估算 99 个意愿点的分配方案。</span>
      </span>
      <span class="tool-card__arrow" aria-hidden="true">→</span>
    </a>
  </section>

  <style>
    .page-head {
      max-width: 760px;
      padding: 48px 0 34px;
    }

    .page-head > p,
    .section-head p {
      margin: 0 0 10px;
      color: var(--accent);
      font-size: .82rem;
      font-weight: 800;
      text-transform: uppercase;
    }

    h1 {
      margin: 0;
      font-size: clamp(2.3rem, 7vw, 4.8rem);
      line-height: 1;
    }

    .page-head > div {
      margin-top: 20px;
      color: var(--muted);
      font-size: 1.05rem;
      line-height: 1.8;
    }

    .tools-section { margin-top: 18px; }
    .section-head h2 { margin: 0; font-size: 1.8rem; }

    .tool-card {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 18px;
      max-width: 760px;
      margin-top: 16px;
      padding: 22px;
      border: 1px solid rgba(20, 103, 216, .17);
      border-radius: 10px;
      background: rgba(255, 255, 255, .8);
      box-shadow: 0 12px 30px rgba(42, 88, 138, .07);
    }

    .tool-card:hover,
    .tool-card:focus-visible {
      border-color: rgba(20, 103, 216, .34);
      background: #fff;
      box-shadow: 0 18px 38px rgba(42, 88, 138, .11);
      outline: none;
      transform: translateY(-1px);
    }

    .tool-card__icon {
      display: grid;
      width: 48px;
      height: 48px;
      border-radius: 10px;
      background: rgba(20, 103, 216, .09);
      color: var(--primary-strong);
      place-items: center;
    }
    .tool-card__icon svg { width: 25px; height: 25px; }
    .tool-card__body { display: grid; gap: 5px; }
    .tool-card__body strong { font-size: 1.08rem; }
    .tool-card__body > span:last-child { color: var(--muted); font-size: .9rem; line-height: 1.6; }
    .tool-card__meta { color: var(--accent); font-size: .72rem; font-weight: 800; letter-spacing: .08em; }
    .tool-card__arrow { color: var(--primary); font-size: 1.3rem; }

    @media (max-width: 640px) {
      .page-head { padding-top: 36px; }
      .tool-card { grid-template-columns: auto minmax(0, 1fr); padding: 18px; }
      .tool-card__icon { width: 42px; height: 42px; }
      .tool-card__arrow { display: none; }
    }
  </style>
</BaseLayout>
